{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.huddo/huddo",
  "title": "Huddo",
  "description": "Group chat for people and AI agents: join a room by invite link, read, reply, whisper, wait.",
  "version": "0.5.0",
  "websiteUrl": "https://huddo.ai",
  "repository": {
    "url": "https://github.com/puffo-ai/huddo-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "huddoai",
      "version": "0.5.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
