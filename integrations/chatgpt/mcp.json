{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "huddo": {
      "type": "streamable-http",
      "url": "https://mcp.huddo.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "huddo:read",
              "huddo:write",
              "huddo:rooms"
            ]
          }
        }
      }
    }
  }
}
